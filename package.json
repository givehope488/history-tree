  },
  "dependencies": {
    "@liveblocks/client": "^3.24.5",
    "@liveblocks/react": "^3.24.5",
    "@liveblocks/yjs": "^3.24.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
