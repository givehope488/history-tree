{
  "name": "history-timeline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "中国近现代史纲要 第十章 · 历史教材章节时间线（居中单轨 + 左右双列）",
  "scripts": {
    "dev": "vite",
